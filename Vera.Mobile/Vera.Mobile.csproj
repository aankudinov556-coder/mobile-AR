<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>Vera.Mobile</RootNamespace>
    <AssemblyName>Vera.Mobile</AssemblyName>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Версия MAUI-пакетов фиксируем явно, чтобы локальная и CI-сборка совпадали независимо от версии workload -->
    <MauiVersion>10.0.120</MauiVersion>

    <!-- Название и идентификатор -->
    <ApplicationTitle>Вера</ApplicationTitle>
    <ApplicationId>com.vera.assistant</ApplicationId>

    <!-- Версия берётся из Directory.Build.props: 2.0.0 → versionName 2.0.0, versionCode 20000 -->
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$([MSBuild]::Add($([MSBuild]::Add($([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Major), 10000)), $([MSBuild]::Multiply($([System.Version]::Parse('$(Version)').Minor), 100)))), $([System.Math]::Max(0, $([System.Version]::Parse('$(Version)').Build)))))</ApplicationVersion>

    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>

    <!-- Ядро использует System.Text.Json через рефлексию (настройки, история) -->
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);CA1416;CA1422;XA0101;NU1608;IL2026;IL2104;IL3050</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <RuntimeIdentifiers>android-arm;android-arm64;android-x64</RuntimeIdentifiers>
    <TrimMode>partial</TrimMode>
  </PropertyGroup>

  <ItemGroup>
    <!-- Сборки, которые работают через рефлексию (JSON) — не обрезать -->
    <TrimmerRootAssembly Include="Vera.Core" />
    <TrimmerRootAssembly Include="Anthropic" />
    <TrimmerRootAssembly Include="OpenAI" />
    <TrimmerRootAssembly Include="System.ClientModel" />
  </ItemGroup>

  <ItemGroup>
    <!-- Иконка: тёмный фон + портрет Веры из ../assets/icon.png -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="..\assets\icon.png" ForegroundScale="0.62" Color="#15131c" />

    <!-- Тёмный сплэш -->
    <MauiSplashScreen Include="..\assets\icon.png" Color="#15131c" BaseSize="144,144" />

    <!-- Векторные иконки интерфейса -->
    <MauiImage Include="Resources\Images\*.svg" />

    <!-- Слои спрайта Веры: как есть, без пережатия (рисуются через SkiaSharp без сглаживания) -->
    <MauiAsset Include="..\assets\vera\*.png" Exclude="..\assets\vera\preview.png" LogicalName="vera/%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="3.119.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Vera.Core\Vera.Core.csproj" />
  </ItemGroup>

</Project>
